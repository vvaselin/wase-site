---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<main class="room" aria-label="水槽のある書斎">
  <div class="room-side room-side-left">
    <section class="shelf shelf-posts">
      <div class="shelf-header">
        <span class="shelf-title">POSTS</span>

        <a
          class="shelf-more"
          href="/posts/"
          aria-label="記事一覧を見る"
        >
          →
        </a>
      </div>

      <div class="books">
        {posts.map((post) => (
          <a
            class="book"
            href={`/posts/${post.id}/`}
            title={post.data.title}
          >
            <span>{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="shelf shelf-games">
      <span>GAMES</span>
    </section>
  </div>

  <div class="center-stage">
    <section class="aquarium">
      <span>AQUARIUM</span>
    </section>

    <div class="character">
      <span>CHARACTER</span>
    </div>

    <div class="desk">
      <span>DESK</span>
    </div>
  </div>

  <div class="room-side room-side-right">
    <section class="shelf shelf-portraits">
      <span>PORTRAITS</span>
    </section>

    <nav class="socials" aria-label="SNS">
      <a href="#">SNS1</a>
      <a href="#">SNS2</a>
      <a href="#">SNS3</a>
    </nav>
  </div>

</main>