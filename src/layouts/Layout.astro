---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "WaseSite" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="WaseSite" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
