---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "個人制作と技術記事をまとめるサイト",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <div class="site-layers">
      <div
        id="visual-background"
        class="visual-layer visual-background"
        aria-hidden="true"
      >
      </div>

      <div id="site-content" class="site-content">
        <slot />
      </div>

      <div
        id="visual-overlay"
        class="visual-layer visual-overlay"
        aria-hidden="true"
      >
      </div>
    </div>
  </body>
</html>

<style>
  .site-layers {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
  }

  .visual-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .visual-background {
    z-index: 0;
  }

  .site-content {
    position: relative;
    z-index: 10;
    min-height: 100vh;
  }

  .visual-overlay {
    z-index: 20;
  }
</style>