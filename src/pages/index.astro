---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Rin Sugiura"
  description="制作物と技術記事をまとめる個人サイト"
>
  <main class="home">
    <section class="hero">
      <p class="eyebrow">Portfolio / Blog / Experiments</p>

      <h1>
        作ったものと、<br />
        考えたこと。
      </h1>

      <p class="description">
        Web、ゲーム、学習支援システムなどの制作物と、
        開発中に考えたことを記録します。
      </p>

      <nav class="links" aria-label="主要ページ">
        <a href="/works">Works</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    display: grid;
    min-height: 100vh;
    padding: var(--space-8);
    place-items: center;
  }

  .hero {
    width: min(100%, var(--content-width));
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .description {
    max-width: 36rem;
    margin: var(--space-8) 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.8;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .links a {
    font-weight: 600;
  }
</style>